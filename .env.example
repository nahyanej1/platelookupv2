# ── Local development only ──────────────────────────────
# Copy this file to .env and fill in real values.
# On Vercel, set these in Project Settings → Environment Variables.
# NEVER commit .env to version control.

PORT=3000

# AutoSweep RFID API credentials (required)
LOGIN_KEY=your_login_key_here
LOGIN_USER=your_login_user_here
LOGIN_PAYLOAD=your_login_payload_here

# Override upstream API base URL (optional)
API_BASE=http://api.autosweeprfidonline.net:45893

# Philippine residential proxy — required when hosting outside PH
PROXY_HOST=sg.proxy.geonode.io
PROXY_PORT=9000
PROXY_USER=your_proxy_user_here
PROXY_PASS=your_proxy_pass_here
